# Copy to .env and edit. Real environment variables override this file. NEVER commit .env.

# ---------- Sketch understanding (VLM) - all optional; offline CLIP fallback is used otherwise
# auto | anthropic | openai | clip | none
S2S_VLM_BACKEND=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_WORKSPACE_ID=        # only if your key is NOT scoped to a workspace
# Any OpenAI-compatible vision endpoint (OpenAI, Gemini OpenAI-compat, Groq, local Ollama, ...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Local & free: run `ollama pull qwen2.5vl` then use
#   OPENAI_BASE_URL=http://localhost:11434/v1  OPENAI_MODEL=qwen2.5vl  OPENAI_API_KEY=ollama

# ---------- Hardware
S2S_DEVICE=auto              # auto | cuda | cpu
S2S_OFFLOAD=auto             # auto | always | never  (auto = offload when VRAM < S2S_LOW_VRAM_GB)
S2S_LOW_VRAM_GB=14

# ---------- Diffusion + ControlNet
S2S_GEN_FAMILY=sd15          # sd15 | sdxl (sdxl needs ~12 GB+ VRAM)
S2S_SD15_MODEL=Lykon/dreamshaper-8
S2S_CONTROL_TYPE=scribble    # scribble | lineart | canny
S2S_NUM_CANDIDATES=2
S2S_STEPS=25
S2S_CFG=7.0
S2S_CN_SCALE=0.9
S2S_CN_END=0.85
S2S_GEN_RES=512

# ---------- Background removal
S2S_REMBG_MODEL=isnet-general-use

# ---------- Image-to-3D
S2S_RECON_BACKEND=triposr    # triposr | instantmesh
S2S_TRIPOSR_MODEL=stabilityai/TripoSR   # or a local folder containing config.yaml + model.ckpt
S2S_MC_RES=256
S2S_BAKE_TEXTURE=0           # 1 = UV texture atlas (needs xatlas + moderngl + OpenGL context)
S2S_TEX_RES=1024
# InstantMesh runs in its own venv (see README)
S2S_INSTANTMESH_DIR=third_party/InstantMesh
S2S_INSTANTMESH_PYTHON=third_party/InstantMesh/.venv/bin/python

# ---------- Server
S2S_PORT=7860
S2S_SHARE=0
S2S_PRELOAD=0
